{
  "name": "express-base-template",
  "version": "1.0.0",
  "description": "Backend API for Express Base Template",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "docker-up": "docker compose up -d --build",
    "docker-down": "docker compose down",
    "start": "tsx src/server.ts",
    "migrate-new": "npx drizzle-kit generate",
    "migrate-up": "npx drizzle-kit migrate",
    "db:delete": "rm -f src/db/database.sqlite",
    "db:reset": "rm -f src/db/database.sqlite && npm run migrate-up"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@react-email/components": "^1.0.12",
    "@types/multer": "^2.3.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-email": "^6.11.16",
    "resend": "^6.39.0",
    "sharp": "^0.34.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
